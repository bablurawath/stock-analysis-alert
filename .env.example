# ==========================================
# Stock AI Notifier Configuration
# ==========================================

# 1. Google Gemini API Key (Get free from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot Configuration (Get free from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Your Telegram Chat ID (Get free from @userinfobot on Telegram)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 4. Polling interval in seconds (default: 60 seconds)
POLL_INTERVAL=60

